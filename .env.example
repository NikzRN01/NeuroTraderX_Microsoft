# Copy this file to .env and fill in real values.
# Docker Compose automatically loads .env from the project root.

# OpenRouter (used by /api/chat and /investment_strategy)
OPENROUTER_API_KEY=

# Steady API (used by /news)
STEADY_API_TOKEN=

# Database connection string for the backend (preferred)
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DB=
